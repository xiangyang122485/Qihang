# ===== Android / Gradle 通用忽略 =====
*.apk
*.aar
# 例外：app/libs/*.aar 包含 OkDownload 本地 AAR，为 app/build.gradle.kts 中
# files("libs/...") 引用的编译期必需依赖。若被通配符 *.aar 排除，新克隆仓库将
# 缺少 app/libs/ 目录下的文件，导致构建失败。因此用否定规则将其重新纳入版本管理。
!app/libs/*.aar
*.ap_
*.aab
*.dex
*.class
bin/
gen/
out/
build/
.gradle/

# 本地 SDK 路径与机器相关配置（含 sdk.dir），不纳入版本管理
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
*.ipr
*.iws
captures/
.externalNativeBuild/
.cxx/
.kotlin/

# 设备截图与临时预览图（可能包含隐私信息，且为一次性产物）
screen_*.png
app-icon-preview.svg

# ===== 本项目私密与敏感文件（不纳入版本管理）=====
# 生产签名 keystore 及配套密码文件
app/keystore/

# 日志 / 临时 / 工作脚本
*.log
_iccheck/
_icontool.py
build_*.txt

# OS / 编辑器
.DS_Store
Thumbs.db

# WorkBuddy 项目记忆（不属于源码仓库内容）
.workbuddy/
