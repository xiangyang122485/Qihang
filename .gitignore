# ===== Android / Gradle 通用忽略 =====
*.apk
*.aar
# 例外：OkDownload 本地 aar 是编译必需依赖（app/build.gradle.kts 里 files("libs/...")），
# 若被忽略则新克隆没有 app/libs/，源码根本构建不了。
!app/libs/*.aar
*.ap_
*.aab
*.dex
*.class
bin/
gen/
out/
build/
.gradle/

# 本地 SDK 路径 / 机器相关配置（含 sdk.dir），绝不入库
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
*.ipr
*.iws
captures/
.externalNativeBuild/
.cxx/
.kotlin/

# 设备截图 / 临时预览图（可能含隐私，且为一次性产物）
screen_*.png
app-icon-preview.svg

# ===== 本项目私密 / 敏感文件（绝不入库）=====
# 生产签名 keystore 及配套密码文件
app/keystore/

# 日志 / 临时 / 工作脚本
*.log
_iccheck/
_icontool.py
build_*.txt

# OS / 编辑器
.DS_Store
Thumbs.db

# WorkBuddy 项目记忆（不应进入源码仓库）
.workbuddy/
