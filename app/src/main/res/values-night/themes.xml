<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      夜间配置下仍使用浅色窗口底色，此为修复「进入应用瞬间显示深色」的关键措施之一。

      原因：本应用默认外观为浅色（用户明确要求），而 Android 选择启动窗口底色时
      仅依据系统 uiMode，不知晓应用内部选择。原此处未声明 windowBackground，
      因此采用父主题 android:Theme.Material 的夜间默认值（深灰），系统深色 + 应用浅色
      = 先显示一帧深色后变为浅色。

      状态栏图标同理先按浅色外观配置深色图标；实际深浅色由 MainActivity 在
      onCreate 中按应用自身选择调用 setTheme 覆盖，因此此配置仅为「防止闪黑」。
      此处亦不声明 android:windowDisablePreview，理由见 values/themes.xml。
    -->
    <style name="Theme.GhDl" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/gh_window_bg</item>
    </style>
</resources>
