<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 起 dataExtractionRules 取代 fullBackupContent，两者同时声明以覆盖 API 26-34。
    应用不备份任何数据：SSH 私钥与 GitHub Token 由 AndroidKeyStore 加密，
    KeyStore 密钥引用与设备绑定，备份还原到新设备后必然失效并表现为「密钥无法恢复」；
    下载记录与任务断点同样不跨设备迁移。
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
